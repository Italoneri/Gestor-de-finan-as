# Copy to .env.deploy on the server and pass it to compose:
#   docker compose --env-file .env.deploy -f docker-compose.prod.yml up -d
#
# This is not the application's .env. That one is rendered inside the container
# by docker/entrypoint.sh from the environment docker-compose.prod.yml sets.

# Subdomain registered at https://duckdns.org, pointed at the VM's public IP.
# Caddy requests a TLS certificate for exactly this name.
APP_DOMAIN=fluxo.duckdns.org

SESSION_NAME=finance_session
