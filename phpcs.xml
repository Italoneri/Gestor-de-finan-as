<?xml version="1.0"?>
<ruleset name="personal-finance">
    <arg name="basepath" value="."/>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>

    <rule ref="PSR12"/>

    <file>src</file>
    <file>public</file>
    <file>database</file>
    <file>tests</file>

    <!-- templates mix HTML and PHP; PSR-12 line/indent rules do not apply well -->
    <exclude-pattern>src/Views/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
</ruleset>
