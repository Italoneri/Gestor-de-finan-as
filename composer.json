{
    "name": "perdido/personal-finance",
    "description": "Personal finance tracker with hand-rolled secure authentication (PHP, no framework)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "check": [
            "@test",
            "@lint"
        ],
        "migrate": "php database/migrate.php",
        "seed": "php database/seed.php",
        "serve": "php -S localhost:8000 -t public public/index.php"
    },
    "config": {
        "sort-packages": true
    }
}
